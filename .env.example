# Tên project -> tên container/volume. Đặt ở đây để cả docker compose (v2) và docker-compose (v1) giống nhau.
COMPOSE_PROJECT_NAME=mgmt-device

# Copy sang .env rồi đổi mật khẩu trước khi chạy ngoài máy cá nhân. KHÔNG commit .env.
POSTGRES_DB=mgmt-device
POSTGRES_USER=mgmt-device
POSTGRES_PASSWORD=change-me
WEB_PORT=8080

# Tài khoản quản trị — service `seed` tạo trong database, mật khẩu lưu dạng băm scrypt.
# Để trống ADMIN_PASSWORD thì hệ thống sinh mật khẩu ngẫu nhiên và in ra đúng một lần.
ADMIN_USERNAME=admin
ADMIN_EMAIL=vydh@matbao.com
ADMIN_NAME=Đặng Hùng Vỹ
ADMIN_PASSWORD=

# Phiên đăng nhập (giờ). COOKIE_SECURE=1 khi chạy sau HTTPS.
SESSION_HOURS=8
COOKIE_SECURE=0
